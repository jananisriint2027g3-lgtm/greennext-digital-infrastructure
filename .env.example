JIRA_BASE_URL=https://trustworkz.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=DI
JIRA_ENABLED=false
JIRA_PARENT_ISSUE_TYPE=
JIRA_JANANI_ACCOUNT_ID=

# Optional server-side analytics enrichment. These values are server-only: do not use VITE_ prefixes.
ANALYTICS_APPS_SCRIPT_URL=
ANALYTICS_ENRICHMENT_SECRET=
# GEO_PROVIDER_URL must be an HTTPS endpoint accepting POST {"ip":"..."}
# with the API key supplied as a server-side Bearer token.
GEO_PROVIDER_URL=https://api.iplocation.net/v2/ip-location
GEO_PROVIDER_API_KEY=
NETWORK_PROVIDER_URL=
NETWORK_PROVIDER_API_KEY=

# Vercel Web Analytics API credentials for server-side aggregate queries
# Required to fetch production analytics metrics (visitors, pageviews, referrers)
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Scheduled Cron Authentication (Vercel Cron)
# Authorization secret verified by /api/cron/* endpoints (Bearer <CRON_SECRET>)
CRON_SECRET=

# Scheduled Google Apps Script Reporting Integration (Server-only, no VITE_ prefix)
# Web App URL of the Google Apps Script deployment that executes reports
REPORT_APPS_SCRIPT_URL=
# Shared secret for authenticating Vercel requests to Google Apps Script doPost(e)
# Must match REPORT_TRIGGER_SECRET configured in Google Apps Script Project Settings -> Script Properties
REPORT_TRIGGER_SECRET=
# Set to "true" locally or in preview environments to simulate execution without remote dispatch
REPORT_TRIGGER_SIMULATION=false

# Google Calendar appointment schedule booking URL (for Technical Session inquiries)
# Example: https://calendar.google.com/calendar/u/0/appointments/schedules/...
VITE_GOOGLE_CALENDAR_APPOINTMENT_URL=

# Visitor Confirmation Email Automation (Server-side, no VITE_ prefix)
# ACTIVE PROVIDER: Google Apps Script (MailApp) - see docs/visitor-email-apps-script.md.
# The website calls the Apps Script `dispatch_email` action using these existing server-only values:
#   URL    = VISITOR_EMAIL_APPS_SCRIPT_URL (optional override) -> else REPORT_APPS_SCRIPT_URL -> else ANALYTICS_APPS_SCRIPT_URL
#            (the Web App /exec URL of the SAME Apps Script deployment that receives the forms)
#   SECRET = VISITOR_EMAIL_SECRET (optional override) -> else REPORT_TRIGGER_SECRET
#            (must equal Script Property REPORT_TRIGGER_SECRET in the Apps Script project)
VISITOR_EMAIL_APPS_SCRIPT_URL=
VISITOR_EMAIL_SECRET=
# Public HTTPS website domain (used by the TypeScript template preview; Apps Script defaults to
# https://greennext-ai.vercel.app or its own PUBLIC_WEBSITE_URL Script Property).
PUBLIC_WEBSITE_URL=https://greennext-ai.vercel.app
# --- Legacy / inactive: Resend is NOT used by the visitor confirmation flow any more. ---
# EMAIL_SIMULATION_MODE, EMAIL_PROVIDER, RESEND_API_KEY, EMAIL_FROM and EMAIL_REPLY_TO are ignored
# by the active path (they remain only for the unused legacy transports in mail-controller.server.ts).
EMAIL_SIMULATION_MODE=true
EMAIL_PROVIDER=simulated
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
