# ==============================================================================
# GreenNext Enterprise Redis & Session Configuration
# ==============================================================================
# Option 1: Direct unified connection string (preferred for cloud providers)
# REDIS_URL=rediss://default:your-password@your-redis-host.com:6380

# Option 2: Individual connection parameters
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password_here
REDIS_TLS=false

# Session configuration
# Session time-to-live in seconds (defaults to exactly 3,600 seconds / 1 hour)
REDIS_SESSION_TTL_SECONDS=3600
